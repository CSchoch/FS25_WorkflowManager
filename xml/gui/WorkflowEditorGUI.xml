<?xml version="1.0" encoding="utf-8"?>
<!--
    WorkflowManager - Workflow Editor GUI Layout
    Allows editing workflow name, vehicle, and steps
-->
<GUI>
    <FrameElement name="WorkflowEditorFrame"
        profile="baseDialogProfile"
        position="0.25 0.1"
        size="0.5 0.8"
        inputMode="ADJUST_TO_CONTENT"
        fadeBackgroundMode="FULLSCREEN">

        <!-- Title bar -->
        <BoxLayoutElement
            alignmentX="left"
            alignmentY="top"
            position="0 0.94"
            size="1 0.06"
            layoutDirection="horizontal">

            <TextElement name="titleText"
                profile="baseHeaderProfile"
                text="$l10n_wm_editor_title"
                textSize="0.022"
                position="0.02 0.01"
                size="0.85 0.05"/>

            <ButtonElement name="closeButton"
                profile="baseButtonSmallProfile"
                position="0.9 0.005"
                size="0.08 0.045"
                text="X"
                onClick="onClickClose"/>
        </BoxLayoutElement>

        <!-- Workflow name input -->
        <BoxLayoutElement name="nameSection"
            alignmentX="left"
            alignmentY="top"
            position="0.02 0.86"
            size="0.96 0.07"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_name"
                textSize="0.016"
                size="0.15 0.05"/>

            <TextInputElement name="nameInput"
                profile="baseTextInputProfile"
                size="0.79 0.05"
                maxCharacters="64"
                onTextChanged="onNameChanged"/>
        </BoxLayoutElement>

        <!-- Vehicle selection -->
        <BoxLayoutElement name="vehicleSection"
            alignmentX="left"
            alignmentY="top"
            position="0.02 0.78"
            size="0.96 0.07"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_vehicle"
                textSize="0.016"
                size="0.15 0.05"/>

            <MultiTextOptionElement name="vehicleDropdown"
                profile="baseMultiTextOptionProfile"
                size="0.79 0.05"
                onSelectionChanged="onVehicleChanged"/>
        </BoxLayoutElement>

        <!-- Steps section header with buttons -->
        <BoxLayoutElement name="stepsHeader"
            alignmentX="left"
            alignmentY="top"
            position="0.02 0.70"
            size="0.96 0.07"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_steps"
                textSize="0.018"
                textBold="true"
                size="0.4 0.05"/>

            <ButtonElement name="moveUpButton"
                profile="baseButtonSmallProfile"
                size="0.08 0.045"
                text="^"
                onClick="onClickMoveUp"
                toolTip="$l10n_wm_tooltip_moveup"/>

            <ButtonElement name="moveDownButton"
                profile="baseButtonSmallProfile"
                size="0.08 0.045"
                text="v"
                onClick="onClickMoveDown"
                toolTip="$l10n_wm_tooltip_movedown"/>

            <ButtonElement name="addStepButton"
                profile="baseButtonSmallProfile"
                size="0.08 0.045"
                text="+"
                onClick="onClickAddStep"
                toolTip="$l10n_wm_tooltip_addstep"/>

            <ButtonElement name="removeStepButton"
                profile="baseButtonSmallProfile"
                size="0.08 0.045"
                text="-"
                onClick="onClickRemoveStep"
                toolTip="$l10n_wm_tooltip_removestep"/>
        </BoxLayoutElement>

        <!-- Steps column headers -->
        <BoxLayoutElement name="stepsColumnHeader"
            alignmentX="left"
            alignmentY="top"
            position="0.02 0.63"
            size="0.96 0.06"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="#"
                textSize="0.014"
                size="0.08 0.04"
                textAlignment="center"/>

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_type"
                textSize="0.014"
                size="0.20 0.04"/>

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_target"
                textSize="0.014"
                size="0.42 0.04"/>

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_action"
                textSize="0.014"
                size="0.28 0.04"/>
        </BoxLayoutElement>

        <!-- Steps list -->
        <ListElement name="stepsList"
            profile="baseListProfile"
            position="0.02 0.15"
            size="0.96 0.47"
            listItemHeight="0.05"
            visibleItems="9"
            onSelectionChanged="onStepSelectionChanged"
            onDoubleClick="onStepDoubleClick"/>

        <!-- Empty steps message -->
        <TextElement name="emptyStepsText"
            profile="baseTextProfile"
            text="$l10n_wm_editor_no_steps"
            textColor="0.7 0.7 0.7 1"
            textSize="0.016"
            position="0.3 0.35"
            size="0.4 0.04"
            visible="false"/>

        <!-- Bottom buttons -->
        <BoxLayoutElement name="bottomButtons"
            alignmentX="center"
            alignmentY="bottom"
            position="0.25 0.02"
            size="0.5 0.10"
            layoutDirection="horizontal">

            <ButtonElement name="saveButton"
                profile="baseButtonProfile"
                size="0.2 0.06"
                text="$l10n_wm_button_save"
                onClick="onClickSave"/>

            <ButtonElement name="cancelButton"
                profile="baseButtonProfile"
                size="0.2 0.06"
                text="$l10n_wm_button_cancel"
                onClick="onClickCancel"/>
        </BoxLayoutElement>

    </FrameElement>

    <!-- Step list item template -->
    <ListItemElement name="StepListItemTemplate"
        profile="baseListItemProfile"
        size="1 0.05">

        <BoxLayoutElement
            layoutDirection="horizontal"
            size="1 1">

            <TextElement name="numberText"
                profile="baseTextProfile"
                textSize="0.014"
                size="0.08 1"
                textAlignment="center"/>

            <TextElement name="typeText"
                profile="baseTextProfile"
                textSize="0.014"
                size="0.20 1"/>

            <TextElement name="targetText"
                profile="baseTextProfile"
                textSize="0.014"
                size="0.42 1"/>

            <TextElement name="actionText"
                profile="baseTextProfile"
                textSize="0.014"
                size="0.28 1"/>
        </BoxLayoutElement>

    </ListItemElement>

    <!-- Add Step Dialog -->
    <FrameElement name="AddStepDialog"
        profile="baseDialogSmallProfile"
        position="0.35 0.3"
        size="0.3 0.4"
        visible="false">

        <TextElement
            profile="baseHeaderProfile"
            text="$l10n_wm_dialog_add_step"
            textSize="0.020"
            position="0.05 0.88"
            size="0.9 0.08"/>

        <!-- Step type selection -->
        <BoxLayoutElement
            position="0.05 0.72"
            size="0.9 0.12"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_type"
                textSize="0.016"
                size="0.3 0.08"/>

            <MultiTextOptionElement name="addStepTypeDropdown"
                profile="baseMultiTextOptionProfile"
                size="0.6 0.08"
                onSelectionChanged="onAddStepTypeChanged"/>
        </BoxLayoutElement>

        <!-- Target selection -->
        <BoxLayoutElement
            position="0.05 0.56"
            size="0.9 0.12"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_target"
                textSize="0.016"
                size="0.3 0.08"/>

            <MultiTextOptionElement name="addStepTargetDropdown"
                profile="baseMultiTextOptionProfile"
                size="0.6 0.08"/>
        </BoxLayoutElement>

        <!-- Action selection -->
        <BoxLayoutElement
            position="0.05 0.40"
            size="0.9 0.12"
            layoutDirection="horizontal">

            <TextElement
                profile="baseTextProfile"
                text="$l10n_wm_editor_action"
                textSize="0.016"
                size="0.3 0.08"/>

            <MultiTextOptionElement name="addStepActionDropdown"
                profile="baseMultiTextOptionProfile"
                size="0.6 0.08"/>
        </BoxLayoutElement>

        <!-- Dialog buttons -->
        <BoxLayoutElement
            position="0.15 0.08"
            size="0.7 0.2"
            layoutDirection="horizontal">

            <ButtonElement name="addStepOkButton"
                profile="baseButtonProfile"
                size="0.3 0.10"
                text="$l10n_button_ok"
                onClick="onClickAddStepOk"/>

            <ButtonElement name="addStepCancelButton"
                profile="baseButtonProfile"
                size="0.3 0.10"
                text="$l10n_wm_button_cancel"
                onClick="onClickAddStepCancel"/>
        </BoxLayoutElement>

    </FrameElement>
</GUI>
