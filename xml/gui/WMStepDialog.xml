<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI inputContext="DIALOG_WMStepDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>
    <GuiElement profile="fs25_dialogBg" size="900px 800px">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <!-- Main content container -->
        <BoxLayout profile="wm_dialogContentContainer">
            <!-- Title -->
            <Text profile="wm_dialogTitle" id="titleElement" text="$l10n_wm_dialog_add_step"/>
            <ThreePartBitmap profile="wm_dialogTitleLineSeparator"/>

            <!-- Step Type Selection -->
            <BoxLayout profile="wm_hBox" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_type" size="150px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="typeDropdown" onStateChanged="onTypeChanged" size="500px 40px" focusId="typeDropdown"/>
            </BoxLayout>

            <!-- Action Dropdown -->
            <BoxLayout profile="wm_hBox" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_action" size="150px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="actionDropdown" onStateChanged="onActionChanged" size="500px 40px"/>
            </BoxLayout>

            <!-- Sync Group (only visible when workflow is linked) -->
            <GuiElement id="syncGroupSection" size="860px 45px">
                <BoxLayout profile="wm_hBox" size="860px 45px">
                    <Text profile="wm_dialogText" text="$l10n_wm_sync_group" size="150px 40px"/>
                    <TextInput profile="fs25_dialogTextInput" id="syncGroupInput" maxCharacters="3" size="80px 40px" focusId="syncGroupInput">
                        <ThreePartBitmap profile="fs25_textInputBg"/>
                    </TextInput>
                </BoxLayout>
            </GuiElement>

            <!-- Target Section -->
            <BoxLayout profile="wm_hBox" size="860px 40px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_target" size="150px 35px"/>
                <TextInput profile="fs25_dialogTextInput" id="targetSearchInput" onTextChanged="onTargetSearchChanged" maxCharacters="50" size="500px 35px" focusId="targetSearch">
                    <ThreePartBitmap profile="fs25_textInputBg"/>
                </TextInput>
            </BoxLayout>

            <BoxLayout profile="wm_hBox" id="targetDropdownContainer" size="860px 120px">
                <GuiElement size="150px 120px"/>
                <BoxLayout flowDirection="horizontal" size="500px 120px">
                    <SmoothList profile="wm_list" id="targetList"
                                onSelectionChanged="onTargetListSelectionChanged"
                                size="500px 120px"
                                focusId="targetList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="targetText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>

                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="targetList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>

            <!-- Unload Target Section (conditional) -->
            <GuiElement id="unloadTargetSection" size="860px 40px">
                <BoxLayout profile="wm_hBox" size="860px 40px">
                    <Text profile="wm_dialogText" id="unloadTargetLabel" text="$l10n_wm_editor_unload_target" size="150px 35px"/>
                    <TextInput profile="fs25_dialogTextInput" id="unloadTargetSearchInput" onTextChanged="onUnloadTargetSearchChanged" maxCharacters="50" size="500px 35px" focusId="unloadSearch">
                        <ThreePartBitmap profile="fs25_textInputBg"/>
                    </TextInput>
                </BoxLayout>
            </GuiElement>

            <BoxLayout profile="wm_hBox" id="unloadTargetDropdownContainer" size="860px 120px">
                <GuiElement size="150px 120px"/>
                <BoxLayout flowDirection="horizontal" size="500px 120px">
                    <SmoothList profile="wm_list" id="unloadTargetList"
                                onSelectionChanged="onUnloadTargetListSelectionChanged"
                                size="500px 120px"
                                focusId="unloadList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="unloadTargetText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>

                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="unloadTargetList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>

            <!-- Fill Type Section (conditional) -->
            <GuiElement id="fillTypeSection" size="860px 40px">
                <BoxLayout profile="wm_hBox" size="860px 40px">
                    <Text profile="wm_dialogText" text="$l10n_wm_editor_fill_type" size="150px 35px"/>
                    <TextInput profile="fs25_dialogTextInput" id="fillTypeSearchInput" onTextChanged="onFillTypeSearchChanged" maxCharacters="50" size="500px 35px" focusId="fillTypeSearch">
                        <ThreePartBitmap profile="fs25_textInputBg"/>
                    </TextInput>
                </BoxLayout>
            </GuiElement>

            <BoxLayout profile="wm_hBox" id="fillTypeDropdownContainer" size="860px 120px">
                <GuiElement size="150px 120px"/>
                <BoxLayout flowDirection="horizontal" size="500px 120px">
                    <SmoothList profile="wm_list" id="fillTypeList"
                                onSelectionChanged="onFillTypeListSelectionChanged"
                                size="500px 120px"
                                focusId="fillTypeList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="fillTypeText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>

                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="fillTypeList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>
        </BoxLayout>

        <!-- Bottom Buttons -->
        <BoxLayout profile="wm_dialogButtonBoxBottom">
            <Button profile="buttonOK" id="confirmButton" text="$l10n_wm_button_save" onClick="onClickConfirm" focusId="confirmBtn"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" id="cancelButton" text="$l10n_wm_button_cancel" onClick="onClickCancel" focusId="cancelStepBtn"/>
        </BoxLayout>
    </GuiElement>
</GUI>
