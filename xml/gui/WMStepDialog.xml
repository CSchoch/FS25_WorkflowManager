<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI inputContext="MENU" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>
    <GuiElement profile="fs25_dialogBg" size="900px 1030px">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <!-- Main content container -->
        <BoxLayout profile="wm_dialogContentContainer">
            <!-- Title + which workflow / step is open (the editor is closed meanwhile) -->
            <Text profile="wm_dialogTitle" id="titleElement" text="$l10n_wm_dialog_add_step"/>
            <Text profile="wm_dialogSubtitle" id="subtitleElement" text=""/>
            <ThreePartBitmap profile="wm_dialogTitleLineSeparator"/>

            <!-- Step Type Selection: label 220 + control 500 = 730 centred by wm_hBox -->
            <BoxLayout profile="wm_hBox" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_type" size="220px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="typeDropdown" onStateChanged="onTypeChanged" size="500px 40px" focusId="typeDropdown"/>
            </BoxLayout>

            <!-- Action Dropdown -->
            <BoxLayout profile="wm_hBox" id="actionRow" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_action" size="220px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="actionDropdown" onStateChanged="onActionChanged" size="500px 40px"/>
            </BoxLayout>

            <!-- Route: target, then unload target. For Load the Lua shows the load point in this
                 first block (driving order), see WMStepDialog:isLoadOrder -->
            <!-- Target: label 220 + [input 460 + spacer 40] 500 = 730 -->
            <BoxLayout profile="wm_hBox" id="targetRow" size="860px 40px">
                <Text profile="wm_dialogText" id="targetLabel" text="$l10n_wm_editor_target" size="220px 35px"/>
                <BoxLayout flowDirection="horizontal" size="500px 35px">
                    <TextInput profile="fs25_dialogTextInput" id="targetSearchInput" onTextChanged="onTargetSearchChanged" maxCharacters="50" size="460px 35px" focusId="targetSearch">
                        <ThreePartBitmap profile="fs25_textInputBg"/>
                    </TextInput>
                    <GuiElement size="40px 35px"/>
                </BoxLayout>
            </BoxLayout>

            <!-- Selected target: spacer 220 + label 500 = 730 -->
            <BoxLayout profile="wm_hBox" id="targetSelectedRow" size="860px 22px">
                <GuiElement size="220px 22px"/>
                <Text profile="wm_selectedText" id="selectedTargetLabel" text="" size="500px 22px"/>
            </BoxLayout>

            <!-- Target dropdown: spacer 260 + [list 500 + slider ~40] 540 = 800 + 10 gap = 810 → left at 25px → list starts at 295px, under the controls -->
            <BoxLayout profile="wm_hBox" id="targetDropdownContainer" size="860px 120px">
                <GuiElement size="260px 120px"/>
                <BoxLayout flowDirection="horizontal" size="540px 120px">
                    <SmoothList profile="wm_list" id="targetList"
                                onSelectionChanged="onTargetListSelectionChanged"
                                size="500px 120px"
                                focusId="targetList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="targetText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="targetList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>

            <!-- Seed Type (conditional: Courseplay field work only) -->
            <BoxLayout profile="wm_hBox" id="seedTypeRow" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_seed_type" size="220px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="seedTypeDropdown" onStateChanged="onSeedTypeChanged" size="500px 40px"/>
            </BoxLayout>

            <!-- Unload Target Section (conditional) -->
            <GuiElement id="unloadTargetSection" size="860px 40px">
                <BoxLayout profile="wm_hBox" size="860px 40px">
                    <Text profile="wm_dialogText" id="unloadTargetLabel" text="$l10n_wm_editor_unload_target" size="220px 35px"/>
                    <BoxLayout flowDirection="horizontal" size="500px 35px">
                        <TextInput profile="fs25_dialogTextInput" id="unloadTargetSearchInput" onTextChanged="onUnloadTargetSearchChanged" maxCharacters="50" size="460px 35px" focusId="unloadSearch">
                            <ThreePartBitmap profile="fs25_textInputBg"/>
                        </TextInput>
                        <GuiElement size="40px 35px"/>
                    </BoxLayout>
                </BoxLayout>
            </GuiElement>

            <!-- Selected unload target: spacer 220 + label 500 = 730 -->
            <BoxLayout profile="wm_hBox" id="unloadSelectedRow" size="860px 22px">
                <GuiElement size="220px 22px"/>
                <Text profile="wm_selectedText" id="selectedUnloadTargetLabel" text="" size="500px 22px"/>
            </BoxLayout>

            <!-- Unload dropdown: spacer 260 + [list 500 + slider ~40] 540 = 810 → list starts at 295px -->
            <BoxLayout profile="wm_hBox" id="unloadTargetDropdownContainer" size="860px 120px">
                <GuiElement size="260px 120px"/>
                <BoxLayout flowDirection="horizontal" size="540px 120px">
                    <SmoothList profile="wm_list" id="unloadTargetList"
                                onSelectionChanged="onUnloadTargetListSelectionChanged"
                                size="500px 120px"
                                focusId="unloadList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="unloadTargetText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="unloadTargetList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>

            <!-- Fill Type Section (conditional) -->
            <GuiElement id="fillTypeSection" size="860px 40px">
                <BoxLayout profile="wm_hBox" size="860px 40px">
                    <Text profile="wm_dialogText" text="$l10n_wm_editor_fill_type" size="220px 35px"/>
                    <BoxLayout flowDirection="horizontal" size="500px 35px">
                        <TextInput profile="fs25_dialogTextInput" id="fillTypeSearchInput" onTextChanged="onFillTypeSearchChanged" maxCharacters="50" size="460px 35px" focusId="fillTypeSearch">
                            <ThreePartBitmap profile="fs25_textInputBg"/>
                        </TextInput>
                        <GuiElement size="40px 35px"/>
                    </BoxLayout>
                </BoxLayout>
            </GuiElement>

            <!-- Selected fill type: spacer 220 + label 500 = 730 -->
            <BoxLayout profile="wm_hBox" id="fillTypeSelectedRow" size="860px 22px">
                <GuiElement size="220px 22px"/>
                <Text profile="wm_selectedText" id="selectedFillTypeLabel" text="" size="500px 22px"/>
            </BoxLayout>

            <!-- Fill type dropdown: spacer 260 + [list 500 + slider ~40] 540 = 810 → list starts at 295px -->
            <BoxLayout profile="wm_hBox" id="fillTypeDropdownContainer" size="860px 120px">
                <GuiElement size="260px 120px"/>
                <BoxLayout flowDirection="horizontal" size="540px 120px">
                    <SmoothList profile="wm_list" id="fillTypeList"
                                onSelectionChanged="onFillTypeListSelectionChanged"
                                size="500px 120px"
                                focusId="fillTypeList">
                        <ListItem profile="wm_listItem" size="500px 30px">
                            <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                                <Text name="fillTypeText" profile="wm_listItemText" size="100% 100%"/>
                            </BoxLayout>
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="fs25_listSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="fillTypeList"/>
                    </ThreePartBitmap>
                </BoxLayout>
            </BoxLayout>

            <!-- Finish before switching (conditional: support sub-steps that run an AD/CP job);
                 below the route so it does not split the two places the vehicle drives to -->
            <BoxLayout profile="wm_hBox" id="finishBeforeSwitchRow" size="860px 45px">
                <Text profile="wm_dialogText" text="$l10n_wm_editor_finish_before_switch" size="220px 40px"/>
                <MultiTextOption profile="fs25_settingsMultiTextOption" id="finishBeforeSwitchDropdown" onStateChanged="onFinishBeforeSwitchChanged" size="500px 40px"/>
            </BoxLayout>

            <!-- Status line: errors and infos while the dialog is open -->
            <Text profile="wm_statusText" id="statusText" text="" size="860px 30px" textOffset="8px 0px"/>
        </BoxLayout>

        <!-- Bottom Buttons -->
        <BoxLayout profile="wm_dialogButtonBoxBottom">
            <Button profile="buttonOK" id="confirmButton" text="$l10n_wm_button_save" onClick="onClickConfirm" focusId="confirmBtn"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack" id="cancelButton" text="$l10n_wm_button_cancel" onClick="onClickCancel" focusId="cancelStepBtn"/>
        </BoxLayout>
    </GuiElement>
</GUI>
