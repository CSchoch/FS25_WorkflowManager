<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="WorkflowManagerMenuFrame" class="WMMenuFrame"
     onCreate="onCreate" onOpen="onFrameOpen" onClose="onFrameClose">

    <!-- Use FrameElement instead of Frame -->
    <FrameElement profile="baseDefaultFrame" name="workflowManagerMenuFrame">

        <!-- Header with title -->
        <BoxLayoutElement name="header" alignmentX="left" alignmentY="top">
            <TextElement text="$l10n_wm_title" name="title" textSize="0.025"/>
        </BoxLayoutElement>

        <!-- Content area -->
        <BoxLayoutElement name="content" alignmentX="left" alignmentY="top" layoutDirection="vertical">

            <!-- Toolbar buttons -->
            <BoxLayoutElement name="toolbar" alignmentX="left" layoutDirection="horizontal">
                <ButtonElement id="buttonNew" text="$l10n_wm_button_new" onClick="onClickNew"/>
                <ButtonElement id="buttonEdit" text="$l10n_wm_button_edit" onClick="onClickEdit"/>
                <ButtonElement id="buttonDelete" text="$l10n_wm_button_delete" onClick="onClickDelete"/>
                <ButtonElement id="buttonStart" text="$l10n_wm_button_start" onClick="onClickStart"/>
                <ButtonElement id="buttonStop" text="$l10n_wm_button_stop" onClick="onClickStop"/>
            </BoxLayoutElement>

            <!-- Workflow list -->
            <ListElement id="workflowList" name="workflowList" onSelectionChanged="onListSelectionChanged">
                <ListItemElement name="workflowListItem">
                    <TextElement name="workflowName"/>
                    <TextElement name="workflowVehicle"/>
                    <TextElement name="workflowSteps"/>
                    <TextElement name="workflowStatus"/>
                </ListItemElement>
            </ListElement>

            <!-- Empty state message -->
            <TextElement name="emptyMessage" text="$l10n_wm_no_workflows" visible="false"/>

        </BoxLayoutElement>

    </FrameElement>

</GUI>
