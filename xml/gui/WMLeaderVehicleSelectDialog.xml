<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI inputContext="MENU" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>
    <GuiElement profile="fs25_dialogBg" size="800px 500px">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <BoxLayout profile="wm_dialogContentContainer">
            <Text profile="wm_dialogTitle" id="titleElement" text="$l10n_wm_leader_select_title"/>
            <ThreePartBitmap profile="wm_dialogTitleLineSeparator"/>

            <!-- Column headers -->
            <BoxLayout flowDirection="horizontal" size="760px 30px">
                <Text profile="wm_columnHeader" text="$l10n_wm_header_vehicle"  size="380px 30px" textOffset="8px 0px"/>
                <Text profile="wm_columnHeader" text="$l10n_wm_header_name"     size="340px 30px" textOffset="8px 0px"/>
                <GuiElement size="40px 30px"/>
            </BoxLayout>

            <!-- Vehicle list -->
            <BoxLayout flowDirection="horizontal" size="760px 280px" margin="0 0 0 10px">
                <SmoothList profile="wm_list" id="vehicleList"
                            onSelectionChanged="onListSelectionChanged"
                            onDoubleClick="onListDoubleClick"
                            size="720px 280px"
                            focusId="vehicleList">
                    <ListItem profile="wm_listItem" size="720px 40px">
                        <BoxLayout flowDirection="horizontal" alignmentY="middle" size="100% 100%">
                            <Text name="leaderVehicleName"   profile="wm_listItemText" size="380px 100%"/>
                            <Text name="leaderWorkflowName"  profile="wm_listItemText" size="340px 100%"/>
                        </BoxLayout>
                    </ListItem>
                </SmoothList>

                <ThreePartBitmap profile="fs25_listSliderBox">
                    <Slider profile="fs25_listSlider" dataElementId="vehicleList"/>
                </ThreePartBitmap>
            </BoxLayout>
        </BoxLayout>

        <!-- Buttons -->
        <BoxLayout profile="wm_dialogButtonBoxBottom">
            <Button profile="buttonOK"     id="selectButton"   text="$l10n_wm_button_select"    onClick="onClickSelect"   focusId="selectBtn"/>
            <Bitmap  profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonActivate"                   text="$l10n_wm_button_no_leader"  onClick="onClickNoLeader" focusId="noLeaderBtn"/>
            <Bitmap  profile="fs25_dialogButtonBoxSeparator"/>
            <Button profile="buttonBack"                       text="$l10n_wm_button_cancel"     onClick="onClickCancel"   focusId="cancelBtn"/>
        </BoxLayout>
    </GuiElement>
</GUI>
