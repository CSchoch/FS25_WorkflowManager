      "id": "bug-017",
      "timestamp": "2026-04-07T23:11:00.000Z",
      "error_message": "Support vehicle restarts sub-steps immediately after completing the last one, instead of waiting for main to advance",
      "file": "src/WorkflowExecutor.lua",
      "root_cause": "Idle polling (waitingForMainStep) checked if current main step has sub-steps, but not whether the main step had actually CHANGED. So after support finished all sub-steps and set waitingForMainStep=true, the very next update cycle saw the same main step still had sub-steps and called onMainStepChanged again, restarting from sub-step 1 in an infinite loop.",
      "fix": "Added activeData.waitingForMainStepIndex to record which main step index triggered the idle state. Idle poll now only calls onMainStepChanged when mainActiveData.currentStep ~= waitingForMainStepIndex. Cleared in onMainStepChanged.",
      "tags": [
        "support-vehicle",
        "looping",
        "idle-poll",
        "executor"
      ],
      "related_bugs": [],
      "occurrences": 1,
      "last_seen": "2026-04-07T23:11:00.000Z"
